<Window x:Class="HonorControl.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Honor Control">
  <Grid x:Name="Root" RequestedTheme="Dark" Background="{ThemeResource PageBrush}">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid x:Name="AppTitleBar" Background="Transparent" Margin="18,0,150,0">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Border Background="#A5CEFF" CornerRadius="7" Width="25" Height="25"><TextBlock Text="H" Foreground="#18283F" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="Honor Control" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="202" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" SelectionChanged="Navigation_SelectionChanged" IsPaneOpen="True">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Uid="Text001" Content="性能与散热" Tag="performance" IsSelected="True"><NavigationViewItem.Icon><FontIcon Glyph="&#xE945;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Uid="Text002" Content="显示与色彩" Tag="display"><NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Uid="Text003" Content="音频" Tag="audio"><NavigationViewItem.Icon><SymbolIcon Symbol="Volume"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Uid="Text004" Content="网络加速" Tag="network"><NavigationViewItem.Icon><FontIcon Glyph="&#xE968;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItemSeparator/>
        <NavigationViewItem x:Uid="Text005" Content="设置与记录" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
        <NavigationViewItem x:Uid="Text006" Content="关于" Tag="about"><NavigationViewItem.Icon><SymbolIcon Symbol="Help"/></NavigationViewItem.Icon></NavigationViewItem>
      </NavigationView.MenuItems>
      <NavigationView.PaneFooter>
        <StackPanel Margin="20,0,16,22" Spacing="7"><TextBlock Text="MAGICBOOK PRO 16" FontSize="10" CharacterSpacing="110" Foreground="{ThemeResource MutedBrush}"/><TextBlock Text="DRA-XX · BIOS 1.13" FontSize="12"/></StackPanel>
      </NavigationView.PaneFooter>
      <Grid Margin="30,18,30,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,22">
          <StackPanel Spacing="7"><TextBlock x:Uid="Text007" x:Name="PageHeading" Text="性能与散热" FontSize="30" FontWeight="SemiBold"/></StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center">
            <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False" Visibility="Collapsed"/>
            <Button x:Name="ConnectButton" Click="Connect_Click" Padding="16,10"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE83D;" FontSize="15"/><TextBlock x:Uid="Text008" x:Name="ConnectLabel" Text="启用硬件控制"/></StackPanel></Button>
          </StackPanel>
        </Grid>
        <InfoBar x:Name="Notice" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="0,0,0,18"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Padding="0,0,4,4">
            <StackPanel x:Name="PerformancePage" Spacing="22">
              <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="20"><StackPanel Spacing="10"><TextBlock x:Uid="Text009" Text="当前性能模式" Style="{StaticResource CaptionLabel}"/><TextBlock x:Uid="Text010" x:Name="CurrentModeText" Text="等待连接" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Uid="Text011" x:Name="ModeFootnote" Text="首次操作授权一次，之后直接切换" Style="{StaticResource CaptionLabel}"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="20"><StackPanel Spacing="10"><TextBlock x:Uid="Text012" Text="CPU 温度" Style="{StaticResource CaptionLabel}"/><TextBlock x:Name="CpuTemperature" Text="— °C" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Uid="Text013" Text="固件实时读数" Style="{StaticResource CaptionLabel}"/></StackPanel></Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20"><StackPanel Spacing="10"><TextBlock x:Uid="Text014" Text="电源状态" Style="{StaticResource CaptionLabel}"/><TextBlock x:Name="PowerSourceText" Text="—" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Uid="Text015" x:Name="PowerSourceHint" Text="连接后读取电源信息" Style="{StaticResource CaptionLabel}"/></StackPanel></Border>
              </Grid>
              <StackPanel Spacing="12"><TextBlock x:Uid="Text016" Text="性能模式" Style="{StaticResource SectionLabel}"/>
                <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <ToggleButton x:Name="SmartModeButton" Tag="firmware-smart" Click="Mode_Click" Style="{StaticResource ModeStyle}"><StackPanel Spacing="13"><FontIcon Glyph="&#xE945;" HorizontalAlignment="Left" FontSize="25" Foreground="{ThemeResource AccentTextBrush}"/><Grid><TextBlock x:Uid="Text017" Text="智能" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Uid="Text018" x:Name="SmartSelected" Text="✓ 已选择" Visibility="Collapsed" Foreground="{ThemeResource AccentTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><TextBlock x:Uid="Text019" Text="固件模式 0，可在电池供电时使用。" Style="{StaticResource CaptionLabel}"/></StackPanel></ToggleButton>
                  <ToggleButton x:Name="PerformanceModeButton" Grid.Column="1" Tag="firmware-performance" Click="Mode_Click" Style="{StaticResource ModeStyle}"><StackPanel Spacing="13"><FontIcon Glyph="&#xE9D9;" HorizontalAlignment="Left" FontSize="25" Foreground="{ThemeResource AccentTextBrush}"/><Grid><TextBlock x:Uid="Text020" Text="高能" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Uid="Text021" x:Name="PerformanceSelected" Text="✓ 已选择" Visibility="Collapsed" Foreground="{ThemeResource AccentTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><TextBlock x:Uid="Text022" Text="固件模式 1，需接通电源且电量至少 20%。" Style="{StaticResource CaptionLabel}"/></StackPanel></ToggleButton>
                  <ToggleButton x:Name="HunterModeButton" Grid.Column="2" Tag="firmware-hunter" Click="Mode_Click" Style="{StaticResource ModeStyle}"><StackPanel Spacing="13"><FontIcon Glyph="&#xE7FC;" HorizontalAlignment="Left" FontSize="25" Foreground="{ThemeResource AccentTextBrush}"/><Grid><TextBlock Text="HUNTER" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Uid="Text023" x:Name="HunterSelected" Text="✓ 已选择" Visibility="Collapsed" Foreground="{ThemeResource AccentTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><TextBlock x:Uid="Text024" Text="固件模式 3，需圆口电源或 135 W 以上 PD。" Style="{StaticResource CaptionLabel}"/></StackPanel></ToggleButton>
                </Grid>
              </StackPanel>
              <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="20">
                <Grid><StackPanel Spacing="5"><TextBlock x:Uid="Text025" Text="风扇转速与预设" Style="{StaticResource SectionLabel}"/><TextBlock x:Uid="Text026" x:Name="FanAvailability" Text="风扇预设仅在 HUNTER 模式下可调。" Style="{StaticResource CaptionLabel}"/></StackPanel><Button x:Uid="Text027" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Refresh_Click" ToolTipService.ToolTip="刷新传感器" AutomationProperties.Name="刷新温度与风扇读数"><FontIcon Glyph="&#xE72C;" FontSize="15"/></Button></Grid>
                <Grid ColumnSpacing="28"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Spacing="8"><TextBlock x:Uid="Text028" Text="风扇 1" Style="{StaticResource CaptionLabel}"/><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock x:Name="Fan0Rpm" Text="—" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="RPM" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5"/></StackPanel><TextBlock x:Uid="Text029" x:Name="Fan0Target" Text="目标 — RPM" Style="{StaticResource CaptionLabel}"/></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="8"><TextBlock x:Uid="Text030" Text="风扇 2" Style="{StaticResource CaptionLabel}"/><StackPanel Orientation="Horizontal" Spacing="7"><TextBlock x:Name="Fan1Rpm" Text="—" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="RPM" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5"/></StackPanel><TextBlock x:Uid="Text031" x:Name="Fan1Target" Text="目标 — RPM" Style="{StaticResource CaptionLabel}"/></StackPanel>
                </Grid>
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <ToggleButton x:Uid="Text032" x:Name="Fan1Button" Content="1 档" Tag="fan-1" Click="Fan_Click" HorizontalAlignment="Stretch" MinHeight="44" FontSize="12" ToolTipService.ToolTip="提交 HUNTER 第 1 档。" IsEnabled="False" Style="{StaticResource SelectionToggleStyle}"/><ToggleButton x:Uid="Text033" x:Name="Fan2Button" Grid.Column="1" Content="2 档" Tag="fan-2" Click="Fan_Click" HorizontalAlignment="Stretch" MinHeight="44" FontSize="12" ToolTipService.ToolTip="提交 HUNTER 第 2 档。" IsEnabled="False" Style="{StaticResource SelectionToggleStyle}"/><ToggleButton x:Uid="Text034" x:Name="Fan3Button" Grid.Column="2" Content="3 档" Tag="fan-3" Click="Fan_Click" HorizontalAlignment="Stretch" MinHeight="44" FontSize="12" ToolTipService.ToolTip="提交 HUNTER 第 3 档。" IsEnabled="False" Style="{StaticResource SelectionToggleStyle}"/><ToggleButton x:Uid="Text035" x:Name="Fan4Button" Grid.Column="3" Content="4 档" Tag="fan-4" Click="Fan_Click" HorizontalAlignment="Stretch" MinHeight="44" FontSize="12" ToolTipService.ToolTip="提交 HUNTER 第 4 档。" IsEnabled="False" Style="{StaticResource SelectionToggleStyle}"/><ToggleButton x:Uid="Text036" x:Name="Fan5Button" Grid.Column="4" Content="5 档" Tag="fan-5" Click="Fan_Click" HorizontalAlignment="Stretch" MinHeight="44" FontSize="12" ToolTipService.ToolTip="提交 HUNTER 第 5 档。" IsEnabled="False" Style="{StaticResource SelectionToggleStyle}"/>
                </Grid>
                <TextBlock x:Uid="Text037" x:Name="FanPresetHint" Text="连接后读取当前预设。" Style="{StaticResource CaptionLabel}"/>
              </StackPanel></Border>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                  <ToggleSwitch x:Uid="Text038" x:Name="AutoPerformanceToggle" Header="自动性能模式" OnContent="开启" OffContent="关闭" Toggled="AutoPerformance_Toggled"/>
                  <TextBlock x:Uid="Text039" Text="识别游戏运行状态，游戏未退出时保持可用的最高模式。启动或退出过程保留 45 秒缓冲。其余场景按前台应用选择模式，手动切换后关闭自动切换。" Style="{StaticResource CaptionLabel}"/>
                  <TextBlock x:Name="AutoPerformanceStatus" Style="{StaticResource CaptionLabel}"/>
                  <Grid>
                    <TextBlock x:Uid="Text040" Text="进程调度" Style="{StaticResource SectionLabel}"/>
                    <ToggleSwitch x:Uid="Text041" x:Name="SchedulerToggle" HorizontalAlignment="Right" OnContent="开启" OffContent="关闭" Toggled="Scheduler_Toggled"/>
                  </Grid>
                  <TextBlock x:Uid="Text042" Text="插电时给选定的前台应用应用 HighQoS。选定的后台应用失焦时使用 EcoQoS，切回前台时恢复。" Style="{StaticResource CaptionLabel}"/>
                  <CheckBox x:Uid="Text043" x:Name="SchedulerAutoForeground" Content="自动识别前台游戏、会议和创作应用" Checked="Scheduler_Toggled" Unchecked="Scheduler_Toggled"/>
                  <StackPanel x:Name="SchedulerControls" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Uid="Text044" Tag="foreground" Content="选择前台应用" Click="ChooseSchedulerApp_Click"/><TextBlock x:Uid="Text045" x:Name="ForegroundAppText" Text="未选择" VerticalAlignment="Center"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Uid="Text046" Tag="background" Content="选择后台应用" Click="ChooseSchedulerApp_Click"/><TextBlock x:Uid="Text047" x:Name="BackgroundAppText" Text="未选择" VerticalAlignment="Center"/></StackPanel>
                    <Button x:Uid="Text048" Content="清除进程规则" Click="ClearScheduler_Click"/>
                  </StackPanel>
                  <TextBlock x:Name="SchedulerStatus" Style="{StaticResource CaptionLabel}"/>
                  <ToggleSwitch x:Uid="Text049" x:Name="ScenePowerToggle" Header="OS Turbo 场景调度" OnContent="开启" OffContent="关闭" Toggled="ScenePower_Toggled"/>
                  <TextBlock x:Uid="Text050" Text="根据前台应用、负载与供电协调 Windows EPP、DTT 功耗策略、风扇表及原厂显卡频偏。HUNTER 保留固件功耗与所选风扇预设。关闭后恢复本应用修改的设置。" Style="{StaticResource CaptionLabel}"/>
                  <TextBlock x:Name="ScenePowerStatus" Style="{StaticResource CaptionLabel}"/>
                  <TextBlock x:Name="DttStatusText" Style="{StaticResource CaptionLabel}"/>
                  <TextBlock x:Name="GpuBoostStatusText" Style="{StaticResource CaptionLabel}"/>
                  <TextBlock x:Name="WindowsPowerPolicyText" Style="{StaticResource CaptionLabel}"/>
                  <Button x:Uid="Text051" Content="读取 DTT 与充电阈值" Click="RefreshFirmwarePolicy_Click"/>
                  <TextBlock x:Name="FirmwarePolicyText" Style="{StaticResource CaptionLabel}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12">
                <Grid><StackPanel Spacing="5"><TextBlock x:Uid="Text052" Text="电池充电保护" Style="{StaticResource SectionLabel}"/><TextBlock x:Uid="Text053" x:Name="ChargeStatus" Text="读取固件保存的充电阈值。" Style="{StaticResource CaptionLabel}"/></StackPanel><Button x:Uid="Text054" HorizontalAlignment="Right" Content="读取阈值" Click="ReadCharge_Click"/></Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ToggleButton x:Uid="Text055" x:Name="ChargeHome" Tag="charge-home" Content="家用 · 40–70%" Style="{StaticResource SelectionToggleStyle}" Click="Charge_Click"/>
                  <ToggleButton x:Uid="Text056" x:Name="ChargeOffice" Tag="charge-office" Content="办公 · 70–90%" Style="{StaticResource SelectionToggleStyle}" Click="Charge_Click"/>
                  <ToggleButton x:Uid="Text057" x:Name="ChargeTravel" Tag="charge-travel" Content="差旅 · 95–100%" Style="{StaticResource SelectionToggleStyle}" Click="Charge_Click"/>
                </StackPanel>
              </StackPanel></Border>
              <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="10">
                <TextBlock x:Uid="Text058" Text="显卡电源与输出" Style="{StaticResource SectionLabel}"/>
                <TextBlock x:Uid="Text059" x:Name="GpuStateText" Text="正在读取独显状态…" FontSize="18"/>
                <TextBlock x:Name="GpuDisplayRoute" Style="{StaticResource CaptionLabel}"/>
                <ComboBox x:Uid="Text060" x:Name="GpuModePicker" Header="显卡电源策略" SelectedIndex="0" SelectionChanged="GpuMode_Changed" MinWidth="260">
                  <ComboBoxItem x:Uid="Text061" Content="关闭自动控制"/><ComboBoxItem x:Uid="Text062" Content="随供电自动切换"/><ComboBoxItem x:Uid="Text063" Content="双显卡"/><ComboBoxItem x:Uid="Text064" Content="集成显卡"/>
                </ComboBox>
                <TextBlock x:Uid="Text065" Text="自动模式插电使用双显卡，电池供电时等待独显空闲 30 秒再关闭。HUNTER 使用双显卡。" Style="{StaticResource CaptionLabel}"/>
                <TextBlock x:Name="GpuPolicyStatus" Style="{StaticResource CaptionLabel}"/>
                <Button x:Uid="Text066" x:Name="ForceIntegratedGpuButton" Content="强制切换为集成显卡" Click="ForceIntegratedGpu_Click" IsEnabled="False"/>
                <TextBlock x:Uid="Text067" Text="在 NVIDIA 控制面板的「管理显示模式」选择自动、Optimus 或 NVIDIA GPU。独显直连用于本机内屏。" Style="{StaticResource CaptionLabel}"/>
                <Button x:Uid="Text068" Content="打开 NVIDIA 控制面板" Click="OpenNvidiaPanel_Click"/>
              </StackPanel></Border>
            </StackPanel>
            <StackPanel x:Name="DisplayPage" Visibility="Collapsed" Spacing="22">
              <Border Style="{StaticResource CardStyle}" Padding="28"><Grid>
                <StackPanel Spacing="12"><Border Background="{ThemeResource AccentSoftBrush}" CornerRadius="6" Padding="10,6" HorizontalAlignment="Left"><TextBlock x:Uid="Text069" x:Name="DisplayModeSummary" Text="正在读取当前色彩…" Foreground="{ThemeResource AccentTextBrush}" FontSize="13"/></Border></StackPanel>
                
              </Grid></Border>
              <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ToggleButton x:Name="SrgbButton" Tag="srgb" Click="Color_Click" Style="{StaticResource ModeStyle}"><StackPanel Spacing="13"><Grid><TextBlock Text="sRGB" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Uid="Text070" x:Name="SrgbSelected" Text="✓ 已选择" Visibility="Collapsed" Foreground="{ThemeResource AccentTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><TextBlock x:Uid="Text071" Text="加载出厂 sRGB LUT，关联 sRGB ICC。" Style="{StaticResource CaptionLabel}"/></StackPanel></ToggleButton>
                <ToggleButton x:Name="P3Button" Grid.Column="1" Tag="p3" Click="Color_Click" Style="{StaticResource ModeStyle}"><StackPanel Spacing="13"><Grid><TextBlock Text="P3" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Uid="Text072" x:Name="P3Selected" Text="✓ 已选择" Visibility="Collapsed" Foreground="{ThemeResource AccentTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><TextBlock x:Uid="Text073" Text="加载出厂 P3 LUT，关联 P3 ICC。" Style="{StaticResource CaptionLabel}"/></StackPanel></ToggleButton>
                <ToggleButton x:Name="NativeButton" Grid.Column="2" Tag="native" Click="Color_Click" Style="{StaticResource ModeStyle}"><StackPanel Spacing="13"><Grid><TextBlock x:Uid="Text074" Text="原生" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Uid="Text075" x:Name="NativeSelected" Text="✓ 已选择" Visibility="Collapsed" Foreground="{ThemeResource AccentTextBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid><TextBlock x:Uid="Text076" Text="使用原生色域，关联原生 ICC。" Style="{StaticResource CaptionLabel}"/></StackPanel></ToggleButton>
              </Grid>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                  <TextBlock x:Uid="Text077" Text="护眼与色温" Style="{StaticResource SectionLabel}"/>
                  <TextBlock x:Uid="Text078" Text="在当前色域 LUT 上叠加显示效果，保持 ICC 关联。电子书按本地时间使用四套色彩矩阵。" Style="{StaticResource CaptionLabel}"/>
                  <ComboBox x:Uid="Text079" x:Name="DisplayEffectPicker" Header="显示效果" SelectedIndex="0" Width="220">
                    <ComboBoxItem x:Uid="Text080" Content="关闭"/><ComboBoxItem x:Uid="Text081" Content="护眼"/><ComboBoxItem x:Uid="Text082" Content="电子书"/>
                  </ComboBox>
                  <Slider x:Uid="Text083" x:Name="TemperatureSlider" Header="色温 · 偏冷 / 默认 / 偏暖" Minimum="-100" Maximum="100" Value="0" StepFrequency="5" MaxWidth="430" HorizontalAlignment="Stretch"/>
                  <StackPanel Orientation="Horizontal" Spacing="12"><Button x:Uid="Text084" Content="应用显示效果" Click="ApplyDisplayEffect_Click"/><TextBlock x:Name="DisplayEffectStatus" VerticalAlignment="Center" Style="{StaticResource CaptionLabel}"/></StackPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Spacing="6"><TextBlock x:Uid="Text085" Text="类自然光亮度" Style="{StaticResource SectionLabel}"/>
                    <TextBlock x:Uid="Text086" Text="内屏亮度在 53% 至 93% 范围内时，每 60 秒渐变一次，最多增加 5 个百分点。电池低于 60% 或启用节电时暂停。" Style="{StaticResource CaptionLabel}"/>
                  </StackPanel>
                  <ToggleSwitch x:Uid="Text087" x:Name="BrightnessRhythmToggle" Grid.Column="1" OnContent="开启" OffContent="关闭" Toggled="BrightnessRhythm_Toggled"/>
                </Grid>
              </Border>
              <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="22">
                <Grid><StackPanel Spacing="5"><TextBlock x:Uid="Text088" Text="唤醒后恢复所选色彩" FontSize="16"/><TextBlock x:Uid="Text089" Text="唤醒或显示器配置变化时恢复。" Style="{StaticResource CaptionLabel}"/></StackPanel><ToggleSwitch x:Uid="Text090" x:Name="ColorWatchToggle" HorizontalAlignment="Right" OffContent="关闭" OnContent="开启" Toggled="ColorWatch_Toggled"/></Grid>
                
              </StackPanel></Border>
              <Border Style="{StaticResource CardStyle}"><Grid><StackPanel Spacing="7"><TextBlock x:Uid="Text091" Text="当前色彩配置" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="IccProfileText" Text="—" Style="{StaticResource CaptionLabel}"/><TextBlock x:Uid="Text092" x:Name="ColorVerificationText" Text="硬件 LUT 与 ICC 状态将分别读取。" Style="{StaticResource CaptionLabel}"/></StackPanel><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Uid="Text093" Content="刷新状态" Click="RefreshColor_Click"/><Button x:Uid="Text094" Content="恢复首次备份" Click="RestoreColor_Click"/></StackPanel></Grid></Border>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                  <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="6"><TextBlock x:Uid="Text095" Text="内屏刷新率" Style="{StaticResource SectionLabel}"/><TextBlock x:Uid="Text096" x:Name="RefreshRateValue" Text="读取中…" FontSize="28" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><ComboBox x:Uid="Text097" x:Name="RefreshRatePicker" Width="160" SelectionChanged="RefreshRate_SelectionChanged" AutomationProperties.Name="选择内屏刷新率"/><Button x:Uid="Text098" Content="读取状态" Click="ReadRefreshRate_Click"/></StackPanel>
                  </Grid>
                  <TextBlock x:Name="RefreshRateDetails" Style="{StaticResource CaptionLabel}"/>
                  <TextBlock x:Uid="Text099" Text="选择目标刷新率后立即应用，保持当前分辨率。快捷键可在设置页修改。" Style="{StaticResource CaptionLabel}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}"><StackPanel Spacing="12"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Uid="Text100" Content="夜间模式" Tag="ms-settings:nightlight" Click="OpenDisplaySettings_Click"/><Button x:Uid="Text101" Content="亮度与显示" Tag="ms-settings:display" Click="OpenDisplaySettings_Click"/><Button x:Uid="Text102" Content="高级显示设置" Tag="ms-settings:display-advanced" Click="OpenDisplaySettings_Click"/></StackPanel></StackPanel></Border>
            </StackPanel>
            <StackPanel x:Name="AudioPage" Visibility="Collapsed" Spacing="20">
              <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                  <TextBlock x:Uid="Text103" Text="外放音效" Style="{StaticResource SectionLabel}"/>
                  <TextBlock x:Uid="Text104" Text="使用已安装的 HONOR Histen 驱动。选择空间音频或立体声风格。" Style="{StaticResource CaptionLabel}"/>
                  <ComboBox x:Uid="Text105" x:Name="SpeakerEffect" Header="扬声器模式" MinWidth="280" SelectionChanged="AudioEffect_Changed" IsEnabled="False">
                    <ComboBoxItem x:Uid="Text106" Tag="speaker-spatial" Content="空间音频"/>
                    <ComboBoxItem x:Uid="Text107" Tag="speaker-standard" Content="立体声 · 标准"/>
                    <ComboBoxItem x:Uid="Text108" Tag="speaker-vocal" Content="立体声 · 人声"/>
